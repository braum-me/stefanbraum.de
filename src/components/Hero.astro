---
import { getT, type Locale } from "~/i18n";

interface Props {
  locale?: Locale;
}
const { locale = "de" } = Astro.props;
const t = getT(locale);
---

<section class="relative px-6 md:px-12 pt-24 md:pt-32 pb-20 md:pb-28 overflow-hidden" data-anim-group="hero">
  <div class="max-w-7xl mx-auto w-full relative">
    <div class="eyebrow" data-anim="eyebrow">{t.hero.eyebrow}</div>

    <div class="grid lg:grid-cols-[1.35fr_1fr] gap-12 lg:gap-20 items-center mt-10 md:mt-14">
      <!-- Left: content -->
      <div class="min-w-0 w-full order-2 lg:order-1">
        <h1 class="heading-hero text-cream max-w-4xl" data-anim="hero-title">
          {t.hero.headlinePart1}
          <span class="text-cream/55 block">{t.hero.headlinePart2}</span>
        </h1>

        <p
          class="font-body text-lg md:text-xl text-cream/75 mt-8 md:mt-10 max-w-2xl leading-[1.55]"
          data-anim="sub"
          data-sub-default={t.hero.sublineDefault}
          data-sub-consulting={t.hero.sublineConsulting}
          id="hero-sub"
        >
          {t.hero.sublineDefault}
        </p>

        <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-3" data-anim="cta">
          <a href="#kontakt" class="btn-primary-mint interactive">
            {t.hero.ctaPrimary}
            <span>&rarr;</span>
          </a>
          <a href="#portfolio" class="btn-outline interactive">
            {t.hero.ctaSecondary}
            <span class="text-mint">&darr;</span>
          </a>
        </div>
      </div>

      <!-- Right: portrait -->
      <div class="order-1 lg:order-2 w-full" data-anim="portrait">
        <figure class="hero-portrait">
          <div class="hero-portrait-frame" id="portrait-frame">
            <img
              src="/portrait-normal.webp"
              alt={t.hero.portraitAlt}
              width="1050"
              height="1500"
              loading="eager"
              fetchpriority="high"
              class="hero-portrait-img hero-portrait-img-clean"
            />
            <img
              src="/portrait-green.webp"
              alt=""
              width="1050"
              height="1500"
              loading="eager"
              class="hero-portrait-img hero-portrait-img-glow"
              aria-hidden="true"
            />
          </div>
          <figcaption class="hero-portrait-caption">
            <span class="hero-portrait-caption-name">{t.hero.portraitName}</span>
            <span class="hero-portrait-caption-sep" aria-hidden="true">&middot;</span>
            <span class="hero-portrait-caption-role">{t.hero.portraitLocation}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>

  <script>
    // URL param swap (consulting only)
    const params = new URLSearchParams(window.location.search);
    const focus = params.get("focus");
    if (focus === "consulting") {
      const sub = document.getElementById("hero-sub");
      if (sub) {
        const text = sub.dataset.subConsulting;
        if (text) sub.textContent = text;
      }
    }

    // Spotlight reveal: glow follows cursor over portrait frame
    const motionOk = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
    const frame = document.getElementById("portrait-frame");
    if (frame && motionOk) {
      const glow = frame.querySelector(".hero-portrait-img-glow") as HTMLElement | null;
      if (glow) {
        const OFF = -400;
        let targetX = OFF;
        let targetY = OFF;
        let currentX = OFF;
        let currentY = OFF;
        let raf = 0;

        const apply = () => {
          glow.style.setProperty("--mx", `${currentX}px`);
          glow.style.setProperty("--my", `${currentY}px`);
        };

        const tick = () => {
          raf = 0;
          currentX += (targetX - currentX) * 0.18;
          currentY += (targetY - currentY) * 0.18;
          apply();
          if (Math.abs(targetX - currentX) > 0.6 || Math.abs(targetY - currentY) > 0.6) {
            raf = requestAnimationFrame(tick);
          }
        };

        const schedule = () => {
          if (!raf) raf = requestAnimationFrame(tick);
        };

        frame.addEventListener("pointermove", (e) => {
          const rect = frame.getBoundingClientRect();
          targetX = e.clientX - rect.left;
          targetY = e.clientY - rect.top;
          schedule();
        });
        frame.addEventListener("pointerenter", (e) => {
          const rect = frame.getBoundingClientRect();
          // teleport in close to entry point so first frame doesn't jump
          currentX = e.clientX - rect.left;
          currentY = e.clientY - rect.top;
          targetX = currentX;
          targetY = currentY;
          apply();
        });
        frame.addEventListener("pointerleave", () => {
          targetX = OFF;
          targetY = OFF;
          schedule();
        });
      }
    }
  </script>

  <style>
    .hero-portrait {
      max-width: 380px;
      width: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    @media (min-width: 1024px) {
      .hero-portrait {
        margin-left: auto;
        margin-right: 0;
        max-width: 420px;
      }
    }

    .hero-portrait-frame {
      position: relative;
      aspect-ratio: 3 / 4;
      width: 100%;
      border-radius: 4px;
      overflow: hidden;
      background: transparent;
      isolation: isolate;
    }

    .hero-portrait-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 18%;
      display: block;
    }
    .hero-portrait-img-clean {
      z-index: 1;
    }
    .hero-portrait-img-glow {
      z-index: 2;
      --mx: -400px;
      --my: -400px;
      -webkit-mask-image: radial-gradient(
        circle 220px at var(--mx) var(--my),
        #000 0%,
        #000 35%,
        transparent 85%
      );
      mask-image: radial-gradient(
        circle 220px at var(--mx) var(--my),
        #000 0%,
        #000 35%,
        transparent 85%
      );
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-portrait-img-glow {
        -webkit-mask-image: none;
        mask-image: none;
      }
      .hero-portrait-img-clean {
        display: none;
      }
    }


    .hero-portrait-caption {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(242, 239, 228, 0.45);
    }
    .hero-portrait-caption-name {
      color: var(--cream);
    }
    .hero-portrait-caption-role {
      color: var(--mint);
    }
    .hero-portrait-caption-sep {
      color: rgba(242, 239, 228, 0.2);
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-portrait-frame {
        box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.6);
      }
    }
  </style>
</section>

<div class="divider"></div>
